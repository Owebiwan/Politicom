{
  "id": "catalonia_1936",
  "name": "Revolutionary Catalonia",
  "description": "19 July 1936. The military uprising has been defeated in Barcelona by armed workers. Factories, farms and trams are collectivized; columns of militia march on Aragon. You are the movement, not the government. Keep the revolution free — and alive — until 1939.",
  "world": "1936",
  "homeState": "ESP",
  // Historical attitudes in July 1936; everything else starts from its ideology.
  // Wars history starts (weeks from 19 July 1936).
  "wars": [
    { "name": "The Second Sino-Japanese War", "tick": 51, "duration": 400, "sideA": ["JPN"], "sideB": ["CHN"] },
    { "name": "The Second World War", "tick": 163, "duration": 300, "sideA": ["DEU", "ITA"], "sideB": ["POL", "GBR", "FRA", "AUS", "NZL", "CAN", "ZAF"] }
  ],
  "stances": { "MEX": 0.55, "SUN": 0.3, "FRA": 0.0, "GBR": -0.25, "USA": -0.05, "DEU": -0.85, "ITA": -0.85, "PRT": -0.8 },
  "startDate": "1936-07-19",
  "endTick": 135,
  "neighborCount": 3,
  "neighborRadiusKm": 25,
  // Republican Spain and foreign purchases supplied grain Catalonia could not grow itself.
  "foodImports": 50,

  "enemies": [ {
    "name": "Nationalist Army",
      "sponsors": ["DEU", "ITA", "PRT"],
    "strength": 1.4,
    "growth": 0.03,
    "offensives": [
      { "name": "The Huesca counter-attack", "tick": 30, "duration": 6, "strength": 1 },
      { "name": "The Aragon Offensive", "tick": 86, "duration": 10, "strength": 28 },
      { "name": "The Catalonia Offensive", "tick": 124, "duration": 12, "strength": 44 }
    ]
  } ],

  "ally": {
    "name": "Republican Government",
    "nextOfferTick": 12,
    "offerInterval": 20,
    "armsGoods": 30
  },

  // Scripted decisions. Ticks are weeks from 19 July 1936. If the movement doesn't answer
  // within expiresAfter weeks (default 4), defaultOption happens — usually what happened historically.
  "events": [
    {
      "id": "cnt_joins_government",
      "tick": 10,
      "title": "Into the Generalitat?",
      "text": "The Generalitat offers the CNT three ministries in a government of antifascist unity. The Central Committee of Antifascist Militias would be dissolved into it.",
      "defaultOption": 0,
      "options": [
        { "label": "Join the government", "description": "Ministers get access to the gold reserves and arms purchases. The committees now answer to them.",
          "effects": { "drift": 6, "influence": 25, "goodsToFront": 30 } },
        { "label": "Stay outside", "description": "The committees keep their power. The government will remember the snub.",
          "effects": { "drift": -1, "influence": -5, "trust": 0.03 } }
      ]
    },
    {
      "id": "durruti_death",
      "tick": 18,
      "title": "Durruti is dead",
      "text": "Buenaventura Durruti has been killed on the Madrid front. Half a million people follow his coffin through Barcelona. His column needs new leadership.",
      "defaultOption": 0,
      "options": [
        { "label": "Let the column elect its delegates", "description": "The militia stays self-managed, but loses its most experienced commander.",
          "effects": { "drift": -2, "enemyStrength": 0.3, "communes": [ "Bujaraloz", "Pina de Ebro" ], "wellbeing": 0.05 } },
        { "label": "Appoint a commander from the war committee", "description": "Continuity at the front, at the price of a chain of command.",
          "effects": { "drift": 3, "enemyStrength": -0.3 } }
      ]
    },
    {
      "id": "may_days",
      "tick": 41,
      "title": "The May Days",
      "text": "Assault Guards seize the Telefónica exchange, held by the CNT since July. Barricades go up across Barcelona. The leadership in Valencia urges a ceasefire; the Friends of Durruti call for resistance.",
      "defaultOption": 0,
      "requiresFederated": [ "Sants textile syndicate" ],
      "options": [
        { "label": "Call for a ceasefire", "description": "Unity holds. The revolution's control of Barcelona ends quietly, and many militants feel betrayed.",
          "effects": { "drift": 6, "influence": -10,
            "communes": [ "Sants textile syndicate", "Poblenou metalworkers", "Barcelona transport collective", "Badalona", "L'Hospitalet" ],
            "trust": -0.08, "wellbeing": -0.05 } },
        { "label": "Hold the barricades", "description": "The revolution is defended in the streets. Civil war within the civil war weakens the front, and the government will send no more arms.",
          "effects": { "drift": -4, "enemyStrength": 1.0, "endAllyOffers": true,
            "communes": [ "Sants textile syndicate", "Poblenou metalworkers", "Barcelona transport collective", "Badalona", "L'Hospitalet" ],
            "trust": 0.05, "wellbeing": -0.12 } }
      ]
    },
    {
      "id": "aragon_council",
      "tick": 55,
      "title": "The Council of Aragon is dissolved",
      "text": "Líster's 11th Division enters Aragon to dissolve the Regional Defense Council and break up the collectives by force.",
      "defaultOption": 0,
      "requiresFederated": [ "Caspe" ],
      "options": [
        { "label": "Accept the dissolution", "description": "Collectives are broken up and their leaders arrested. Aragon's villages lose faith in the federation.",
          "effects": { "drift": 4,
            "communes": [ "Caspe", "Alcañiz", "Calanda", "Mas de las Matas", "Alcorisa", "Fraga", "Binéfar", "Monzón", "Barbastro", "Graus", "Sariñena", "Bujaraloz", "Pina de Ebro" ],
            "wellbeing": -0.2, "trust": -0.05 } },
        { "label": "Negotiate", "description": "Give up the Council to save the collectives. It costs most of the movement's standing.",
          "effects": { "drift": 2, "influence": -20,
            "communes": [ "Caspe", "Alcañiz", "Calanda", "Mas de las Matas", "Alcorisa", "Fraga", "Binéfar", "Monzón", "Barbastro", "Graus", "Sariñena", "Bujaraloz", "Pina de Ebro" ],
            "wellbeing": -0.05 } },
        { "label": "Defend the collectives", "description": "Militias face Republican troops. The collectives survive; the front pays for it, and the government cuts off arms.",
          "effects": { "drift": -2, "enemyStrength": 1.5, "endAllyOffers": true,
            "communes": [ "Caspe", "Alcañiz", "Calanda", "Mas de las Matas", "Alcorisa", "Fraga", "Binéfar", "Monzón", "Barbastro", "Graus", "Sariñena", "Bujaraloz", "Pina de Ebro" ],
            "wellbeing": -0.08, "trust": 0.05 } }
      ]
    },
    {
      "id": "sim_police",
      "tick": 62,
      "title": "The SIM offers its services",
      "text": "The new Military Investigation Service offers to root out fifth columnists and 'uncontrollables' in the collectives.",
      "defaultOption": 1,
      "options": [
        { "label": "Cooperate with the SIM", "description": "Saboteurs are caught. So are a good number of anarchists.",
          "effects": { "drift": 8, "enemyStrength": -0.8, "trust": -0.05 } },
        { "label": "Refuse", "description": "The collectives police themselves, as they always have.",
          "effects": { "influence": -5 } }
      ]
    },
    {
      "id": "ebro",
      "tick": 105,
      "title": "The Battle of the Ebro",
      "text": "The Republic stakes everything on a crossing of the Ebro and asks every collective for people and materiel.",
      "defaultOption": 1,
      "options": [
        { "label": "Send everything", "description": "Full mobilization blunts the enemy before the last offensive — and leaves the collectives hollowed out.",
          "effects": { "drift": 4, "enemyStrength": -3, "wellbeing": -0.1 } },
        { "label": "Send volunteers only", "description": "Those who want to fight go. The collectives keep working.",
          "effects": { "enemyStrength": -1 } }
      ]
    }
  ],

